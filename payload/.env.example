# Wordt gebruikt om sessies te ondertekenen. Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# De publieke URL van de site. Gebruikt voor canonicals, Open Graph en
# live preview. In productie: https://mellowbikers.nl
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Custom domain op de R2-bucket, binnen dezelfde Cloudflare-zone. Laat je
# dit leeg, dan lopen beeldtransformaties via /api/media/file/ op de site
# zelf — dat werkt alleen als de site binnen de zone draait, en kost
# Worker-CPU per thumbnail. In productie: https://cdn.mellowbikers.nl
NEXT_PUBLIC_MEDIA_BASE_URL=

# Cloudflare Turnstile. De site key is publiek; de secret is een Worker
# secret. Ontbreekt de secret, dan weigert elk formulier bewust.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optioneel: log level van Payload op Workers (info, debug, warn, error)
PAYLOAD_LOG_LEVEL=info

# Postmark, voor formuliernotificaties. Zonder token worden inzendingen
# wel opgeslagen maar niet gemaild.
POSTMARK_API_TOKEN=
EMAIL_FROM=info@mellowbikers.nl
